# Cloudflare Pages — política de caché del frontend Flutter Web.
# Entradas principales y service worker nunca se cachean en disco para garantizar
# que los despliegues de producción se reflejen de inmediato en dispositivos móviles y de escritorio.

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

/flutter_bootstrap.js
  Cache-Control: no-cache, no-store, must-revalidate

/flutter_service_worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/main.dart.js
  Cache-Control: public, max-age=0, must-revalidate

/flutter.js
  Cache-Control: public, max-age=604800

/canvaskit/*
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800
